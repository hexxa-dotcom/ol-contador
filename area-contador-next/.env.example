NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Analytics 4 (site público — landing, /precos, /radar). Fallback só
# usado se não houver nada salvo em Configurações > Chaves de API > Marketing
# & Analytics no painel do contador (essa é a forma recomendada de trocar,
# não exige redeploy). ID no formato G-XXXXXXXXXX, em Admin > Fluxos de dados
# > seu site, no GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Somente para rotas executadas no servidor. Nunca usar NEXT_PUBLIC_ em segredos.
# Bypassa RLS — só usar em src/lib/supabase/admin.ts e equivalentes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (cobranças, assinaturas, NFS-e). Produção: https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_SECRET=

# IA (Copiloto, diagnóstico, relatório, análise de documento). GROQ_API_KEY
# presente + IA_PROVIDER vazio => usa Groq por padrão; IA_PROVIDER força um dos dois.
IA_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Só para embeddings do RAG de skills (text-embedding-3-small), não para chat.
OPENAI_API_KEY=

# SERPRO / Integra Contador (Radar Fiscal) — mTLS + OAuth2.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# Certificado e chave do e-CNPJ, já convertidos de .pfx para PEM puro e
# codificados em base64 (Node/OpenSSL 3 não lê mais 3DES/RC2 legado do .pfx).
SERPRO_CERT_PEM_BASE64=
SERPRO_KEY_PEM_BASE64=
SERPRO_CNPJ_CONTRATANTE=

# SERPRO CND — produto/credenciais separados do Integra Contador.
SERPRO_CND_URL=
SERPRO_CND_TOKEN_URL=
SERPRO_CND_CONSUMER_KEY=
SERPRO_CND_CONSUMER_SECRET=

# SERPRO/PGFN Dívida Ativa — produto/credenciais separados do Integra Contador.
SERPRO_DIVIDA_ATIVA_CONSUMER_KEY=
SERPRO_DIVIDA_ATIVA_CONSUMER_SECRET=
SERPRO_DIVIDA_ATIVA_BASE_URL=
SERPRO_DIVIDA_ATIVA_TOKEN_URL=

# Cofre gov.br — chave de cifragem do cofre de senha (AES-256-GCM).
# Obrigatória (sem fallback para SUPABASE_SERVICE_ROLE_KEY, diferente do legado).
GOVBR_VAULT_KEY=

# Notificações — e-mail via Resend.
RESEND_API_KEY=
RESEND_FROM=

# WhatsApp Cloud API (Meta) — avisos de andamento e chat interno (aba WhatsApp
# na área do contador). Ativação e número: Meta Business > WhatsApp Business
# Platform. WHATSAPP_TEMPLATE_NAME é o template de utilidade aprovado pela
# Meta, usado para mensagens que o sistema inicia (fora da janela de 24h).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
# Número (formato internacional, ex: +5547999999999) que recebe aviso interno
# de nova compra via WhatsApp, enquanto não há número de produção próprio.
WHATSAPP_ADMIN_PHONE=
# Template dedicado ao aviso interno acima (nome/serviço/valor + botão pro
# painel) — diferente do WHATSAPP_TEMPLATE_NAME usado nas notificações ao cliente.
WHATSAPP_ADMIN_TEMPLATE_NAME=
